---
/**
 * Knocket 在线聊天加载器（零成本版）
 *
 * 性能保证：
 * 1. enable 为 false 时，不输出任何 DOM、脚本、请求（字面意义上的零字节）。
 * 2. 脚本使用 is:inline，不产生额外的 JS chunk 请求。
 * 3. click 模式下，887 KB 的 SDK 只在用户点击后注入，首屏完全不受影响。
 * 4. 加载失败/超时会降级到邮箱，不会把访客卡死。
 *
 * 用法：
 *   import ChatLoader from '@/components/knocket/ChatLoader.astro'
 *   <ChatLoader />                 // 用 knocket.config.ts 的默认 mode
 *   <ChatLoader mode='click' />    // 覆盖 mode
 */
import { knocket } from '@/knocket.config'

interface Props {
  mode?: 'click' | 'idle' | 'immediate'
  label?: string
  class?: string
}

const { mode = knocket.mode, label = knocket.label, class: className } = Astro.props
const active = knocket.enable && Boolean(knocket.identifier)
---

{
  active && (
    <div
      class={className}
      data-identifier={knocket.identifier}
      data-idle-timeout={knocket.idleTimeout}
      data-knocket-root
      data-mode={mode}
      data-slow-threshold={knocket.slowThreshold}
    >
      {mode === 'click' && (
        <button
          class='inline-flex items-center gap-2 rounded-lg border border-border bg-muted px-4 py-2 text-sm font-medium transition-colors hover:bg-primary hover:text-primary-foreground'
          data-knocket-trigger
          type='button'
        >
          <svg
            aria-hidden='true'
            fill='none'
            height='16'
            stroke='currentColor'
            stroke-linecap='round'
            stroke-linejoin='round'
            stroke-width='1.8'
            viewBox='0 0 24 24'
            width='16'
          >
            <path d='M21 11.5a8.4 8.4 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.4 8.4 0 0 1-3.8-.9L3 21l1.9-5.7a8.4 8.4 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.4 8.4 0 0 1 3.8-.9h.5a8.5 8.5 0 0 1 8 8v.5z' />
          </svg>
          <span data-knocket-label>{label}</span>
        </button>
      )}

      <p class='mt-2 text-xs text-muted-foreground' data-knocket-hint hidden>
        Live chat is unavailable right now.
        {knocket.fallbackEmail ? (
          <>
            You can also email{' '}
            <a class='underline' href={`mailto:${knocket.fallbackEmail}`}>
              {knocket.fallbackEmail}
            </a>
            .
          </>
        ) : (
          'Please try again later.'
        )}
      </p>

      <script is:inline>
        ;(function () {
          var SDK = 'https://trtc.io/knocket-sdk/sdk.js'
          var loaded = {}

          function inject(id, cb) {
            if (loaded[id]) return
            loaded[id] = true
            var s = document.createElement('script')
            s.src = SDK + '?identifier=' + encodeURIComponent(id)
            s.async = true
            s.setAttribute('data-knocket', id)
            s.onload = function () {
              cb(null)
            }
            s.onerror = function () {
              loaded[id] = false
              cb(new Error('load-failed'))
            }
            document.body.appendChild(s)
          }

          function boot(root) {
            var id = root.getAttribute('data-identifier')
            if (!id) return
            var mode = root.getAttribute('data-mode') || 'click'
            var hint = root.querySelector('[data-knocket-hint]')
            var slow = parseInt(root.getAttribute('data-slow-threshold'), 10) || 12000

            function fail() {
              if (hint) hint.hidden = false
            }

            if (mode === 'immediate') {
              inject(id, function (err) {
                if (err) fail()
              })
              return
            }

            if (mode === 'idle') {
              var queue = function () {
                var timeout = parseInt(root.getAttribute('data-idle-timeout'), 10) || 6000
                var run = function () {
                  inject(id, function (err) {
                    if (err) fail()
                  })
                }
                if ('requestIdleCallback' in window) requestIdleCallback(run, { timeout: timeout })
                else setTimeout(run, 2000)
              }
              if (document.readyState === 'complete') queue()
              else window.addEventListener('load', queue, { once: true })
              return
            }

            var btn = root.querySelector('[data-knocket-trigger]')
            var labelEl = root.querySelector('[data-knocket-label]')
            if (!btn) return
            var text = labelEl ? labelEl.textContent : ''

            function restore() {
              btn.disabled = false
              btn.className = btn.className.replace(' opacity-60 cursor-progress', '')
              if (labelEl) labelEl.textContent = text
            }

            // 只有当 SDK 真的把气泡挂到页面上时才收起按钮，
            // 否则（identifier 无效、被拦截）必须把入口还给用户。
            // SDK 把气泡渲染在 #contact-widget-auto 的 shadow DOM 里，
            // 宿主本身宽高为 0，必须深入 shadow root 找可见元素（如 .trtc-float-card）。
            function hasVisibleNode(el) {
              var rect = el.getBoundingClientRect()
              if (rect.width > 0 && rect.height > 0) return true
              var sr = el.shadowRoot
              if (!sr) return false
              var nodes = sr.querySelectorAll('*')
              for (var j = 0; j < nodes.length; j++) {
                var nr = nodes[j].getBoundingClientRect()
                if (nr.width > 0 && nr.height > 0) return true
              }
              return false
            }

            function confirmMounted(before) {
              var tries = 0
              var timer2 = setInterval(function () {
                tries++
                var mounted = false
                for (var i = 0; i < document.body.children.length; i++) {
                  var el = document.body.children[i]
                  if (el.tagName === 'SCRIPT' || before.has(el)) continue
                  if (hasVisibleNode(el)) {
                    mounted = true
                    break
                  }
                }
                if (mounted) {
                  clearInterval(timer2)
                  root.style.display = 'none'
                  return
                }
                if (tries >= 10) {
                  clearInterval(timer2)
                  restore()
                  fail()
                }
              }, 500)
            }

            btn.addEventListener('click', function () {
              if (btn.disabled) return
              var before = new Set(document.body.children)
              btn.disabled = true
              btn.className += ' opacity-60 cursor-progress'
              if (labelEl) labelEl.textContent = 'Connecting…'
              var timer = setTimeout(fail, slow)

              inject(id, function (err) {
                clearTimeout(timer)
                if (err) {
                  restore()
                  fail()
                  return
                }
                confirmMounted(before)
              })
            })
          }

          var roots = document.querySelectorAll('[data-knocket-root]')
          for (var i = 0; i < roots.length; i++) boot(roots[i])
        })()
      </script>
    </div>
  )
}
