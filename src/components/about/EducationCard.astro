---
import { Image } from 'astro:assets'

import { cn } from 'astro-pure/utils'

type Props = {
  heading: string
  subheading?: string
  date?: string
  /** Watermark image rendered on the right edge of the card */
  logo?: ImageMetadata
  /** Watermark opacity, 0 - 1 */
  logoOpacity?: number
  class?: string
}

const { heading, subheading, date, logo, logoOpacity = 0.55, class: className } = Astro.props
---

<div
  class={cn(
    'not-prose relative block overflow-hidden rounded-2xl border bg-muted px-5 py-3',
    className
  )}
>
  {
    logo && (
      <div class='edu-logo-wrap' style={`--logo-opacity:${logoOpacity}`} aria-hidden='true'>
        <Image src={logo} alt='' loading='lazy' />
      </div>
    )
  }
  <div class='relative flex flex-col gap-y-1.5'>
    <div class='flex flex-col gap-y-0.5'>
      <h2 class='text-lg font-medium'>{heading}</h2>
      {subheading && <p class='text-muted-foreground'>{subheading}</p>}
      {date && <p class='text-muted-foreground'>{date}</p>}
    </div>
    <slot />
  </div>
</div>

<style>
  .edu-logo-wrap {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    user-select: none;
  }

  .edu-logo-wrap :global(img) {
    position: absolute;
    top: 50%;
    right: 1.5rem;
    height: 86%;
    width: auto;
    max-width: none;
    transform: translateY(-50%);
    opacity: var(--logo-opacity, 0.55);
  }

  /* 暗色：深色线条在深底上本就不可见，提亮会让彩色部分变成发光贴纸。
     改为反相 + 去色得到灰白线条，再用 screen 混合让反相后的背景彻底消失。 */
  :global(.dark) .edu-logo-wrap :global(img) {
    opacity: calc(var(--logo-opacity, 0.55) * 0.72);
    filter: invert(1) grayscale(1);
    mix-blend-mode: screen;
  }
</style>
