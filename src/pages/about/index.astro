---
import { Button, Card } from 'astro-pure/user'
import PageLayout from '@/layouts/CommonPage.astro'
import Substats from '@/components/about/Substats.astro'
import EducationCard from '@/components/about/EducationCard.astro'
import umLogo from '@/assets/logos/um.png'
import sjtuLogo from '@/assets/logos/sjtu.png'
import swuLogo from '@/assets/logos/swu.png'

const headings = [
  { depth: 2, slug: 'education', text: 'Education' },
  { depth: 2, slug: 'social-networks', text: 'Social Networks' },
  { depth: 2, slug: 'about-blog', text: 'About Blog' }
]
---

<PageLayout title='About' {headings} comment>
  <p>A PhD student in Biomedicine</p>
  <p>Hi, I’m Han<br />
    Here are the articles that I have written or excerpted</p>
  <Button title='Sponsor Me' class='w-fit' href='/projects#sponsorship' variant='ahead' />

  {/* education */}
  <h2 id='education'>Education</h2>
  <div class='education-cards'>
    <EducationCard
      class='mb-4'
      heading='University of Macau'
      subheading='PhD in Biomedicine'
      date='August 2024 - Present'
      logo={umLogo}
    />

    <EducationCard
      class='mb-4'
      heading='Shanghai Jiao Tong University'
      subheading='Master of Biological and Pharmaceutical Sciences (Food Engineering)'
      date='September 2021 - June 2024'
      logo={sjtuLogo}
    />

    <EducationCard
      class='mb-4'
      heading='Southwest University'
      subheading='Bachelor of Animal Science (Food Science Direction)'
      date='September 2017 - June 2021'
      logo={swuLogo}
    />
  </div>
  
  <style>
    .education-cards {
      display: flex;
      flex-direction: column;
      gap: 16px;
      width: 100%;
    }
  </style>

  {/* social-networks */}
  <h2 id='social-networks'>Social Networks</h2>
  <p>
    Find me across these platforms — research notes, tools and everyday thoughts. GitHub follower
    count is fetched in real time.
  </p>
  <Substats
    stats={[
      {
        platform: 'GitHub',
        icon: 'github',
        link: 'https://github.com/hanhan124',
        text: 'followers',
        api: 'github/hanhan124'
      },
      {
        platform: 'Douyin',
        icon: 'tiktok',
        color: '#ff0050',
        link: 'https://v.douyin.com/AvA09RAhfiY/',
        text: 'followers'
      },
      {
        platform: 'Xiaohongshu',
        icon: 'instagram',
        color: '#ff2442',
        link: 'https://www.xiaohongshu.com/user/profile/5eac2d6e0000000001000b9b?xsec_token=YBABOPzP-4pU2wJ9rQzW8zfaW0y_r_rqLoqiVnkiDse08%3D&xsec_source=app_share&xhsshare=CopyLink&shareRedId=N0tDQzVJOk42NzUyOTgwNjY0OTc0Rz9L&apptime=1757791769&share_id=83f24763a08f4ac09eec95964151b99e&share_channel=copy_link',
        text: 'followers'
      },
      {
        platform: 'Zhihu',
        icon: 'zhihu',
        color: '#0066ff',
        link: 'https://www.zhihu.com/people/han-shuo-61-11',
        text: 'followers'
      },
      {
        platform: 'Bilibili',
        icon: 'bilibili',
        color: '#FB7299',
        link: 'https://space.bilibili.com/302091696',
        text: 'followers'
      },
      {
        platform: 'Coolapk',
        icon: 'coolapk',
        color: '#21bdd2',
        link: 'http://www.coolapk.com/u/1085514',
        text: 'followers'
      },
      {
        platform: 'Netease Cloud Music',
        icon: 'netease',
        color: '#c20c0c',
        link: 'https://y.music.163.com/m/user?id=352934338',
        text: 'followers'
      }
    ]}  />

  {/* about-blog */}
  <h2 id='about-blog'>About Blog</h2>
  <p>Website history:</p>
  <div class='education-cards'>
    <Card 
      class='mb-4' 
      heading='Website Refactored'
      subheading='Using Astro and Astro Theme Resume'
      date='2025-09-01'
    />
  </div>
  <p>
    The smooth operation and personalized customization of website also rely on the resources and
    technical support provided by the following excellent projects/service providers:
  </p>
  <ul>
    <li>Domain: <a href='#' target='_blank'>Vercel</a></li>
    <li>
      Framework & Theme: <a href='https://astro.build/' target='_blank'>Astro</a> + <a
        href='https://github.com/cworld1/astro-theme-pure'
        target='_blank'>Astro Theme Pure</a
      >
    </li>
    <li>
      Site hosting: <a href='https://vercel.com/' target='_blank'>Vercel</a>
    </li>
    <li>
      CI/CD: <a href='https://vercel.com/workflow' target='_blank'>Vercel Workflow</a>
    </li>
    <!-- <li>Resources speedup: <a href='https://cdn.cbd.int/' target='_blank'>CBD CDN</a></li> -->
    <li>Comment system: <a href='https://waline.js.org' target='_blank'>Waline</a></li>
    <li>
      Visits: <a href='https://supabase.com/' target='_blank'>Supabase</a> +
      <a href='https://waline.js.org/' target='_blank'>Waline</a>
    </li>
    <li>
      Other statistics: <a href='https://github.com/spencerwooo/substats' target='_blank'
        >Substats</a
      >
    </li>
  </ul>
</PageLayout>
