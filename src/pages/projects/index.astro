---
import { Image } from 'astro:assets'

import { Button, Icon } from 'astro-pure/user'
import PageLayout from '@/layouts/CommonPage.astro'
import ProjectSection from '@/components/projects/ProjectSection.astro'
import Sponsorship from '@/components/projects/Sponsorship.astro'
import alipay from '@/assets/qrcodes/alipay-qrcode.jpg'
import wechat from '@/assets/qrcodes/wechat-qrcode.jpg'

const headings = [
  { depth: 2, slug: 'programs', text: 'Programs' },
  { depth: 2, slug: 'others', text: 'Others' },
  { depth: 2, slug: 'sponsorship', text: 'Sponsorship' }
]
---

<PageLayout title='Projects' {headings} view>
  <p>Github Activities:</p>
  <p>
    <Image
      src='https://ghchart.rshah.org/659eb9/hanhan124'
      alt='github activities'
      inferSize
      loading='lazy'
    />
  </p>
  <p>
    If you think it would be useful or interesting to collaborate on a project, you can donate to
    support my work or contact me to discuss a project.
  </p>
  <Button title='Checkout sponsorship' class='w-fit' href='#sponsorship'>
    <Icon class='size-5' name='receive-money' slot='before' />
  </Button>

  <h2 id='programs'>Programs</h2>
  <ProjectSection
    projects={[
      {
        name: '🧬 Mynx',
        description: 'Bioinformatics toolkit for laboratory data processing.',
        links: [{ type: 'github', href: 'https://github.com/hanhan124/mynx' }]
      },
      {
        name: '🖥️ Mynx Web',
        description: 'Web interface for Mynx — qPCR plates, TIFF imaging and AI-assisted analysis.',
        links: [{ type: 'github', href: 'https://github.com/hanhan124/mynx-web' }]
      },
      {
        name: '🧪 PlateEditor',
        description: 'Browser-based editor for qPCR plate layouts.',
        image: 'nova-PCRPlates.jpg',
        links: [{ type: 'site', href: '/PlateEditor.html' }]
      }
    ]}
  />

  <h2 id='others'>Others</h2>
  <ProjectSection
    projects={[
      {
        name: '📜 Shiro',
        description: 'A minimalist personal website theme embodying the purity of paper.',
        links: [{ type: 'github', href: 'https://github.com/hanhan124/Shiro' }]
      },
      {
        name: '🍎 ASUS FL5500L EFI',
        description: 'Hackintosh EFI configuration for ASUS FL5500L.',
        links: [{ type: 'github', href: 'https://github.com/hanhan124/ASUS-FL5500L-EFI' }]
      }
    ]}
  />

  <!-- sponsorship -->
  <h2 id='sponsorship'>Sponsorship</h2>
  <p>Please leave a message or contact me proactively after sponsorship.</p>
  <Sponsorship
    methods={[
      { name: 'WeChat', icon: 'wechat-pay', image: wechat },
      { name: 'Alipay', icon: 'alipay', image: alipay }
    ]}
  />
</PageLayout>

<style>
  .sponsorship-card {
    & .sponsorship-card-img {
      opacity: 0.3;
      --un-blur: blur(4px);
      filter: var(--un-blur);
    }

    &:hover {
      & .sponsorship-card-icon {
        opacity: 0;
      }
      & .sponsorship-card-img {
        opacity: 1;
        --un-blur: blur(0);
      }
    }
  }
</style>
